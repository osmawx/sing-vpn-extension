{
  "manifest_version": 3,
  "minimum_chrome_version": "108",
  "name": "Sing VPN",
  "version": "1.0.0",
  "description": "Browser VPN: connect through your own HTTP/HTTPS/SOCKS5 proxies.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sing VPN",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}